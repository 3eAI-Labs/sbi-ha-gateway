@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sbi:    <https://arinna.3eai-labs.com/ontology/sbi-ha-gateway#> .
@prefix arinna: <https://arinna.3eai-labs.com/ontology/core#> .

# =============================================================================
# SBI HA Gateway — product ontology.
# Authored in the product repo (NOT in arinna/core/reasoner). Uploaded to TMF at
# onboarding as ProductSpecification characteristic `arinna.shapes.shacl`.
#
# Vocabulary mirrors the Arinna-addressable (x-arinna) surface in
# deploy/helm/sbi-ha-gateway/values.schema.json. Each property maps 1:1 to a
# ProductDefinition property so the reasoner can gate write-class intents
# symbolically. Kept in sync with values.schema.json and internal/config/config.go.
# =============================================================================

sbi: a owl:Ontology ;
    rdfs:label "SBI HA Gateway configuration ontology" ;
    owl:versionInfo "0.1.0" ;
    rdfs:comment "Symbolic contract for Arinna-tunable SBI HA Gateway configuration." .

sbi:ProductConfig a owl:Class ;
    rdfs:subClassOf arinna:ProductConfig ;
    rdfs:label "SBI HA Gateway product configuration" ;
    rdfs:comment "A resolved set of Helm-values-layer knobs Arinna may write for this product." .

# --- Sizing / blast-radius ---------------------------------------------------
sbi:replicaCount a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:integer ;
    rdfs:label "pod replica count (replicaCount)" .
sbi:pdbMinAvailable a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:integer ;
    rdfs:label "PodDisruptionBudget minAvailable (pdb.minAvailable)" .

# --- Registry (§8.1) ---------------------------------------------------------
sbi:imageRegistry a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "image registry host (image.registry) — must be allowlisted" .
sbi:imageTag a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "image tag (image.tag) — must be pinned, not :latest" .

# --- Runtime / load shedding -------------------------------------------------
sbi:logLevel a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "log level (config.logLevel)" .
sbi:natsUrl a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "NATS cluster URL (config.nats.url)" .
sbi:rateLimitRps a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:decimal ;
    rdfs:label "rate-limit RPS, 0 disables (config.rateLimit.rps)" .
sbi:rateLimitBurst a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:integer ;
    rdfs:label "rate-limit burst (config.rateLimit.burst)" .
sbi:outboundProfile a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "outbound delivery profile (config.outbound.profile)" .
sbi:otaEnabled a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:boolean ;
    rdfs:label "OTA UECM/SMSF subjects enabled (config.ota.enabled)" .

# --- Security posture (auth / mTLS / audit) ----------------------------------
sbi:mtlsClientAuthMode a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "inbound mTLS mode: off|optional|require (config.mtls.clientAuthMode)" .
sbi:mtlsClientCAFile a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "inbound peer-CA bundle path (config.mtls.clientCAFile)" .
sbi:mtlsOutboundCertFile a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "outbound client certificate path (config.mtls.outboundCertFile)" .
sbi:mtlsOutboundKeyFile a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "outbound client key path (config.mtls.outboundKeyFile)" .
sbi:mtlsOutboundCAFile a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "outbound trust anchor path (config.mtls.outboundCAFile)" .
sbi:allowPlaintextSbi a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:boolean ;
    rdfs:label "cleartext SBI port opt-out (config.security.allowPlaintextSbi)" .
sbi:outboundAllowAny a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:boolean ;
    rdfs:label "outbound destination allowlist opt-out (config.outbound.allowAny)" .
sbi:oauthDisabled a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:boolean ;
    rdfs:label "OAuth2 NF-token auth kill switch (config.oauth.disabled)" .
sbi:oauthAudience a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "expected aud claim / this NF instance ID (config.oauth.audience)" .
sbi:oauthNrfJwksUrl a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "NRF JWKS endpoint (config.oauth.nrfJwksUrl)" .
sbi:oauthJwksFile a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "static JWKS file, CI/airgap fallback (config.oauth.jwksFile)" .
sbi:oauthRequireCertBinding a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:boolean ;
    rdfs:label "RFC 8705 cnf binding required (config.oauth.requireCertBinding)" .
sbi:auditDisabled a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:boolean ;
    rdfs:label "audit kill switch (config.audit.disabled)" .
sbi:auditNatsSubject a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "audit event subject, tenant-prefixable (config.audit.natsSubject)" .

# --- Secret reference --------------------------------------------------------
sbi:tlsExistingSecret a owl:DatatypeProperty ;
    rdfs:domain sbi:ProductConfig ; rdfs:range xsd:string ;
    rdfs:label "TLS Secret name (tls.existingSecret) — secret-ref-only, never inline" .
