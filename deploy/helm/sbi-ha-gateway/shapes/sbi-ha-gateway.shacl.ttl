@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sbi:    <https://arinna.3eai-labs.com/ontology/sbi-ha-gateway#> .
@prefix arinna: <https://arinna.3eai-labs.com/ontology/core#> .

# =============================================================================
# SBI HA Gateway — SHACL write-class safety shapes.
# The reasoner runs these as a gate on write-class intents Arinna forms against a
# ProductDefinition of this product. Constraints mirror (and must stay in sync
# with) values.schema.json bounds — the schema types the surface, these shapes
# enforce the *operational* safety envelope: registry allowlist, ranges,
# secret-ref-only, and — the real value here — the cross-field security
# invariants documented in internal/config/config.go ("partial config is fatal",
# "must opt in by setting AUDIENCE and a JWKS source", RFC 8705 pairing).
# Products with no shape run no-op through the gate; this bundle
# opts SBI HA Gateway into enforcement.
# =============================================================================

sbi:ProductConfigShape a sh:NodeShape ;
    sh:targetClass sbi:ProductConfig ;

    # --- Registry allowlist (§8.1) -------------------------------------------
    sh:property [
        sh:path sbi:imageRegistry ;
        sh:datatype xsd:string ;
        sh:not [ sh:pattern "^(https?://|127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|localhost)" ] ;
        sh:message "image.registry must be an allowlisted registry — no http(s):// scheme, RFC-1918 private IP, or localhost (§8.1 / ARIN-ONB-0014)." ;
    ] ;
    # image tag must be pinned — never :latest (mutable-tag hazard).
    sh:property [
        sh:path sbi:imageTag ;
        sh:datatype xsd:string ;
        sh:not [ sh:pattern "^latest$" ] ;
        sh:message "image.tag must be pinned, not 'latest' (§8.1 immutable-tag)." ;
    ] ;

    # --- Sizing / blast-radius ------------------------------------------------
    sh:property [
        sh:path sbi:replicaCount ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 32 ;
        sh:message "replicaCount out of range [1,32]." ;
    ] ;
    sh:property [
        sh:path sbi:pdbMinAvailable ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ;
        sh:message "pdb.minAvailable must be >= 0." ;
    ] ;

    # --- Enums (mirror schema) ------------------------------------------------
    sh:property [
        sh:path sbi:logLevel ;
        sh:in ( "debug" "info" "warn" "error" ) ; sh:maxCount 1 ;
        sh:message "config.logLevel must be debug|info|warn|error." ;
    ] ;
    sh:property [
        sh:path sbi:mtlsClientAuthMode ;
        sh:in ( "off" "optional" "require" ) ; sh:maxCount 1 ;
        sh:message "config.mtls.clientAuthMode must be off|optional|require." ;
    ] ;
    sh:property [
        sh:path sbi:outboundProfile ;
        sh:in ( "sbi_direct" "scef_rest" ) ; sh:maxCount 1 ;
        sh:message "config.outbound.profile must be sbi_direct|scef_rest." ;
    ] ;

    # --- Load shedding --------------------------------------------------------
    sh:property [
        sh:path sbi:rateLimitRps ;
        sh:datatype xsd:decimal ; sh:minInclusive 0 ;
        sh:message "config.rateLimit.rps must be >= 0 (0 disables)." ;
    ] ;
    sh:property [
        sh:path sbi:rateLimitBurst ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ;
        sh:message "config.rateLimit.burst must be >= 0." ;
    ] ;

    # --- Audit subject: NATS subject grammar (tenant-prefixable) --------------
    sh:property [
        sh:path sbi:auditNatsSubject ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Za-z0-9._-]+(\\.[A-Za-z0-9._*>-]+)*$" ;
        sh:message "config.audit.natsSubject must be a valid NATS subject." ;
    ] ;

    # --- Secret-ref-only: must be a Secret NAME (RFC1123 label), never inline --
    # Empty allowed (h2c / no TLS). A credential literal (spaces, PEM, long) fails.
    sh:property [
        sh:path sbi:tlsExistingSecret ;
        sh:datatype xsd:string ;
        sh:pattern "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$" ;
        sh:maxLength 253 ;
        sh:message "tls.existingSecret must be a Secret name, not inline cert material (§2.1 secretRefOnly)." ;
    ] .

# =============================================================================
# Cross-field security invariants (SHACL-SPARQL) — the carrier-grade guards from
# internal/config/config.go. A partial security config is worse than none: it
# looks enabled but silently fails open/closed. These reject such intents.
# =============================================================================

# Secure by default: TLS, client certificates and OAuth are required,
# each switched off only explicitly. A trial install (config.nats.url empty: the bundled NATS)
# is exempt — the chart switches off what it lacks, so that its defaults start.

# 1. OAuth completeness — OAuth on (the default) without an audience AND a JWKS source
#    deploys auth that can never validate a token; outside a trial install the chart
#    refuses to render it.
sbi:OAuthOptInCompleteShape a sh:NodeShape ;
    sh:targetClass sbi:ProductConfig ;
    sh:sparql [
        sh:message "Outside a trial install, OAuth (config.oauth.disabled=false) requires a non-empty oauth.audience AND at least one JWKS source (nrfJwksUrl or jwksFile); or config.oauth.disabled=true." ;
        sh:select """
            PREFIX sbi: <https://arinna.3eai-labs.com/ontology/sbi-ha-gateway#>
            SELECT $this WHERE {
                $this sbi:natsUrl ?nu . FILTER ( ?nu != "" )
                FILTER NOT EXISTS { $this sbi:oauthDisabled true }
                OPTIONAL { $this sbi:oauthAudience ?aud }
                OPTIONAL { $this sbi:oauthNrfJwksUrl ?ju }
                OPTIONAL { $this sbi:oauthJwksFile ?jf }
                FILTER (
                    ( !BOUND(?aud) || ?aud = "" ) ||
                    ( ( !BOUND(?ju) || ?ju = "" ) && ( !BOUND(?jf) || ?jf = "" ) )
                )
            }
        """ ;
    ] .

# 2. Outbound TLS pairing — a certificate without its key (or the reverse), or a client
#    certificate without a CA, is fatal at start-up; a CA alone is TLS without a client
#    certificate (internal/sbi/client.go buildOutboundTLS).
sbi:MtlsOutboundPairingShape a sh:NodeShape ;
    sh:targetClass sbi:ProductConfig ;
    sh:sparql [
        sh:message "config.mtls.outboundCertFile and outboundKeyFile go together, and with outboundCAFile; outboundCAFile alone is allowed." ;
        sh:select """
            PREFIX sbi: <https://arinna.3eai-labs.com/ontology/sbi-ha-gateway#>
            SELECT $this WHERE {
                OPTIONAL { $this sbi:mtlsOutboundCertFile ?c }
                OPTIONAL { $this sbi:mtlsOutboundKeyFile ?k }
                OPTIONAL { $this sbi:mtlsOutboundCAFile ?a }
                BIND( ( BOUND(?c) && ?c != "" ) AS ?hasC )
                BIND( ( BOUND(?k) && ?k != "" ) AS ?hasK )
                BIND( ( BOUND(?a) && ?a != "" ) AS ?hasA )
                FILTER ( ( ?hasC != ?hasK ) || ( ?hasC && ! ?hasA ) )
            }
        """ ;
    ] .

# 3. Cert-binding requires mTLS — requireCertBinding=true with clientAuthMode=off
#    rejects every token (RFC 8705 cnf needs a client cert; config.go:64).
sbi:CertBindingRequiresMtlsShape a sh:NodeShape ;
    sh:targetClass sbi:ProductConfig ;
    sh:sparql [
        sh:message "config.oauth.requireCertBinding=true requires config.mtls.clientAuthMode != off (RFC 8705)." ;
        sh:select """
            PREFIX sbi: <https://arinna.3eai-labs.com/ontology/sbi-ha-gateway#>
            SELECT $this WHERE {
                $this sbi:oauthRequireCertBinding true .
                $this sbi:mtlsClientAuthMode "off" .
            }
        """ ;
    ] .

# 4. Client certificates need TLS and a trust anchor — outside a trial install,
#    clientAuthMode optional|require (require is the default) needs tls.existingSecret with
#    ca.crt and config.mtls.clientCAFile; the chart refuses to render it otherwise.
sbi:MtlsRequiresCAShape a sh:NodeShape ;
    sh:targetClass sbi:ProductConfig ;
    sh:sparql [
        sh:message "Outside a trial install, config.mtls.clientAuthMode optional|require requires tls.existingSecret AND config.mtls.clientCAFile; or clientAuthMode off." ;
        sh:select """
            PREFIX sbi: <https://arinna.3eai-labs.com/ontology/sbi-ha-gateway#>
            SELECT $this WHERE {
                $this sbi:natsUrl ?nu . FILTER ( ?nu != "" )
                OPTIONAL { $this sbi:mtlsClientAuthMode ?m }
                FILTER ( !BOUND(?m) || ?m = "optional" || ?m = "require" )
                OPTIONAL { $this sbi:mtlsClientCAFile ?ca }
                OPTIONAL { $this sbi:tlsExistingSecret ?sec }
                FILTER ( ( !BOUND(?ca) || ?ca = "" ) || ( !BOUND(?sec) || ?sec = "" ) )
            }
        """ ;
    ] .

# 5. TLS on the SBI port — outside a trial install, tls.existingSecret is required unless
#    config.security.allowPlaintextSbi=true; the chart refuses to render it otherwise.
sbi:TlsRequiredShape a sh:NodeShape ;
    sh:targetClass sbi:ProductConfig ;
    sh:sparql [
        sh:message "Outside a trial install, the SBI port needs tls.existingSecret, or config.security.allowPlaintextSbi=true." ;
        sh:select """
            PREFIX sbi: <https://arinna.3eai-labs.com/ontology/sbi-ha-gateway#>
            SELECT $this WHERE {
                $this sbi:natsUrl ?nu . FILTER ( ?nu != "" )
                FILTER NOT EXISTS { $this sbi:allowPlaintextSbi true }
                OPTIONAL { $this sbi:tlsExistingSecret ?sec }
                FILTER ( !BOUND(?sec) || ?sec = "" )
            }
        """ ;
    ] .

# 6. TLS on the admin port — on by default, with the SBI certificate: outside a trial install it
#    needs tls.existingSecret unless config.admin.tls=false; the chart refuses to render it
#    otherwise. (The admin token needs no shape: without config.admin.tokenSecret the chart
#    creates one.)
sbi:AdminTlsRequiresTlsShape a sh:NodeShape ;
    sh:targetClass sbi:ProductConfig ;
    sh:sparql [
        sh:message "Outside a trial install, the admin port is served with the SBI certificate: it needs tls.existingSecret, or config.admin.tls=false." ;
        sh:select """
            PREFIX sbi: <https://arinna.3eai-labs.com/ontology/sbi-ha-gateway#>
            SELECT $this WHERE {
                $this sbi:natsUrl ?nu . FILTER ( ?nu != "" )
                FILTER NOT EXISTS { $this sbi:adminTls false }
                OPTIONAL { $this sbi:tlsExistingSecret ?sec }
                FILTER ( !BOUND(?sec) || ?sec = "" )
            }
        """ ;
    ] .
