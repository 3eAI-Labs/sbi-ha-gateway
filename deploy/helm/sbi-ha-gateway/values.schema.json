{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Arinna machine-API surface for the SBI HA Gateway chart (Product Packaging Contract v2.0 §2/§2.1): draft-07, additionalProperties:false with a global escape, x-arinna discipline. Fields carrying `x-arinna` are Arinna-tunable ProductDefinition properties (§2.1 exposure boundary); fields without it keep chart defaults. Chart-only — stateless HTTP/2↔NATS bridge, no CRD/operator. opsTrigger N/A (no in-app reconciler). Config surface mirrors internal/config/config.go.",
  "title": "sbi-ha-gateway Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "config"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "description": "Helm-injected global values. Not Arinna-addressable."
    },

    "replicaCount": {
      "type": "integer", "minimum": 1, "maximum": 32,
      "description": "Number of gateway pods. Stateless; NATS queue-group shares load.",
      "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "low", "serviceLevelPreset": true }
    },

    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container image. Platform/publish concern — not operator-tunable. §8.1: registry must be allowlisted (no scheme, private IP or localhost); the tag defaults to the chart appVersion, never latest.",
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "pattern": "^([\\w][\\w.-]{0,127})?$", "description": "Empty: the chart appVersion." },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },

    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },

    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },

    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer" },
        "runAsGroup": { "type": "integer" },
        "fsGroup": { "type": "integer" },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"] },
            "localhostProfile": { "type": "string" }
          }
        }
      }
    },

    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOnlyRootFilesystem": { "type": "boolean" },
        "allowPrivilegeEscalation": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drop": { "type": "array", "items": { "type": "string" } },
            "add": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "sbiPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },

    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pod resource requests/limits. Participates in service-level sizing.",
      "properties": {
        "requests": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "cpu": { "type": "string", "pattern": "^[0-9]+(m|\\.[0-9]+)?$|^[0-9]+$" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ki|M|G|K)$" }
          }
        },
        "limits": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "cpu": { "type": "string", "pattern": "^[0-9]+(m|\\.[0-9]+)?$|^[0-9]+$" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ki|M|G|K)$" }
          }
        }
      },
      "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "low", "serviceLevelPreset": true }
    },

    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 64 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "low", "serviceLevelPreset": true }
    },

    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "type": "integer", "minimum": 0,
          "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "medium", "serviceLevelPreset": true }
        }
      }
    },

    "terminationGracePeriodSeconds": {
      "type": "integer", "minimum": 1,
      "description": "Time the kubelet allows the gateway after SIGTERM. Must exceed config.shutdown.drainDelay plus config.shutdown.timeout."
    },

    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nats"],
      "description": "Application configuration (rendered to env; mirrors internal/config/config.go).",
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sbiPort": { "type": "string", "pattern": "^[0-9]{1,5}$" },
            "adminPort": { "type": "string", "pattern": "^[0-9]{1,5}$" }
          }
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "low" }
        },
        "nats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": {
              "type": "string",
              "description": "URL of the NATS the applications use. Empty: the chart deploys its own core NATS (nats.deploy) for a trial install, which no application is connected to; required when nats.deploy is false. Changing it rolls the pods.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "high", "requiresApproval": true }
            },
            "connectTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "requestTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "secret": {
              "type": "object",
              "additionalProperties": false,
              "description": "Credentials and TLS for config.nats.url, from a Secret the operator provides, mounted read-only at /etc/sbi-gateway/nats. Name the keys the Secret holds; leave the others empty. One authentication: user with passwordKey, tokenKey, credsKey or nkeySeedKey. TLS: caKey, and certKey with keyKey for a client certificate. The gateway refuses contradicting settings at start-up.",
              "properties": {
                "name": { "type": "string" },
                "user": { "type": "string" },
                "passwordKey": { "type": "string" },
                "tokenKey": { "type": "string" },
                "credsKey": { "type": "string" },
                "nkeySeedKey": { "type": "string" },
                "caKey": { "type": "string" },
                "certKey": { "type": "string" },
                "keyKey": { "type": "string" }
              }
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRetries": {
              "type": "integer", "minimum": 1, "maximum": 100,
              "description": "Passes over a notification's callback URIs, the first included. Below 1 the gateway does not start."
            },
            "baseDelay": {
              "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$",
              "description": "Wait after the first failed pass; doubles after each further one. Must be positive."
            }
          }
        },
        "notify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workers": {
              "type": "integer", "minimum": 1, "maximum": 1024,
              "description": "Notifications delivered at once; one whose network function does not answer holds one. Their order is not kept."
            }
          }
        },
        "shutdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drainDelay": {
              "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$",
              "description": "After SIGTERM the gateway serves on this long, answering not ready, before it stops listening. Plus timeout, it must stay below terminationGracePeriodSeconds. 0s closes at once."
            },
            "timeout": {
              "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$",
              "description": "After the drain delay: the time the requests in flight, the notification deliveries and the SMS being sent have to finish. Plus drainDelay, it must stay below terminationGracePeriodSeconds."
            }
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-client token bucket in front of the back end. rps=0 disables.",
          "properties": {
            "rps": {
              "type": "number", "minimum": 0,
              "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "medium" }
            },
            "burst": {
              "type": "integer", "minimum": 0,
              "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "medium" }
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "description": "TLS cert/key file paths (material mounted via tls.existingSecret). Empty ⇒ h2c.",
          "properties": {
            "certFile": { "type": "string" },
            "keyFile": { "type": "string" }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "description": "Secure by default: TLS, client certificates and OAuth are required unless each is switched off explicitly. A trial install (bundled NATS) opts out of what it lacks.",
          "properties": {
            "allowPlaintextSbi": {
              "type": "boolean",
              "description": "Serve cleartext h2c without tls.existingSecret. A high-risk security change.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "high", "requiresApproval": true }
            }
          }
        },
        "mtls": {
          "type": "object",
          "additionalProperties": false,
          "description": "Peer cert verification (TS 33.310).",
          "properties": {
            "clientCAFile": { "type": "string" },
            "clientAuthMode": {
              "type": "string",
              "enum": ["off", "optional", "require"],
              "description": "Inbound client certificates. Default require: needs tls.existingSecret with ca.crt and clientCAFile. Security-critical — approval-gated.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "high", "requiresApproval": true }
            },
            "outboundCertFile": { "type": "string" },
            "outboundKeyFile": { "type": "string" },
            "outboundCAFile": { "type": "string" }
          }
        },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "description": "OAuth2 NF token auth (TS 33.501 §13.4.1).",
          "properties": {
            "disabled": {
              "type": "boolean",
              "description": "Auth kill switch: true accepts SBI requests without an access token. Default false: set audience and nrfJwksUrl (or jwksFile). A high-risk security change.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "high", "requiresApproval": true }
            },
            "audience": {
              "type": "string",
              "description": "Expected aud claim (this NF's instance ID).",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "high" }
            },
            "nrfJwksUrl": {
              "type": "string",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "high" }
            },
            "jwksFile": { "type": "string" },
            "jwksRefresh": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "clockSkew": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "resultCacheTTL": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "requireCertBinding": {
              "type": "boolean",
              "description": "RFC 8705 — reject tokens without cnf. Pair with mTLS.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "high" }
            }
          }
        },
        "outbound": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string",
              "enum": ["sbi_direct", "scef_rest"],
              "description": "Delivery of data-change notifications: sbi_direct POSTs to the callback URI, scef_rest leaves it to an external adapter.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "medium" }
            },
            "allowedDestinations": {
              "type": "array",
              "items": { "type": "string", "pattern": "^([*]?[.]?[A-Za-z0-9.-]+|[0-9A-Fa-f:.]+(/[0-9]{1,3})?)$" },
              "description": "Hosts callbacks and SMSF calls may reach: host names, .domain suffixes, CIDR blocks, addresses. Empty: none (unless allowAny). Loopback, link-local and multicast addresses only when listed by address.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "high", "requiresApproval": true }
            },
            "allowAny": {
              "type": "boolean",
              "description": "Allow callbacks and SMSF calls to any host but loopback, link-local, unspecified and multicast addresses. A high-risk security change.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "high", "requiresApproval": true }
            }
          }
        },
        "ota": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Opens the SMS (OTA) surfaces: serving-SMSF lookup and Nsmsf SendSMS. Needs config.nats.url: the stream OTA_OUTBOUND is on the applications' NATS, not on the bundled one.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "medium" }
            },
            "resolverFile": { "type": "string" },
            "uecmTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "disabled": {
              "type": "boolean",
              "description": "Audit kill switch. Disabling audit is high-risk / approval-gated.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "riskClass": "high", "requiresApproval": true }
            },
            "natsSubject": {
              "type": "string",
              "description": "Audit event subject; tenant-prefixable for multi-tenant clusters.",
              "x-arinna": { "userExposed": true, "mutableAtRuntime": false, "tenantScoped": true, "riskClass": "medium" }
            }
          }
        }
      }
    },

    "extraVolumes": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Further pod volumes, for files the gateway reads by path (outbound TLS, JWKS file, OTA resolver): usually a Secret or a ConfigMap."
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Mounts of extraVolumes in the gateway container; mount them read-only."
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ingress to the gateway pods: the SBI port from sbiFrom (empty: anywhere); the admin port, which has no authentication, from pods in the release namespace and adminFrom.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "x-arinna": { "userExposed": true, "mutableAtRuntime": true, "riskClass": "high", "requiresApproval": true }
        },
        "sbiFrom": { "type": "array", "items": { "type": "object" }, "description": "NetworkPolicyPeer entries allowed to reach the SBI port; empty: anywhere." },
        "adminFrom": { "type": "array", "items": { "type": "object" }, "description": "NetworkPolicyPeer entries allowed to reach the admin port besides the release namespace, e.g. Prometheus." }
      }
    },

    "tls": {
      "type": "object",
      "additionalProperties": false,
      "description": "TLS secret sourcing. Cert material is a secret reference, never inline.",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Name of a pre-created Secret (tls.crt/tls.key/ca.crt). Empty ⇒ h2c.",
          "x-arinna": { "userExposed": false, "secretRef": true, "requiresApproval": true, "riskClass": "high" }
        },
        "mountPath": { "type": "string" }
      }
    },

    "nats": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bundled single-replica core NATS, deployed only when config.nats.url is empty. For a trial or smoke install, not for production.",
      "properties": {
        "deploy": {
          "type": "boolean",
          "description": "Deploy the bundled NATS when config.nats.url is empty. False: config.nats.url is required.",
          "x-arinna": { "userExposed": false, "mutableAtRuntime": false, "riskClass": "medium" }
        },
        "image": { "type": "string", "minLength": 1 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
            "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
          }
        }
      }
    }
  }
}
